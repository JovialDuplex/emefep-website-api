# Configuration de l'API pour un déploiement Netlify.
# Les identifiants réels sont à définir dans Netlify > Site configuration > Environment variables.

NODE_ENV=production

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Facultatif si l'identité de service Google est fournie via GOOGLE_APPLICATION_CREDENTIALS.
# Dans Netlify, collez le JSON du compte de service sur une seule ligne dans cette variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
