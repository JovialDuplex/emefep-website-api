PORT='votre port ou le serveur sera deployer (local uniquement)'

# NODE_ENV : "development" (local), "test" ou "production"
NODE_ENV="development"

# Base de donnees LOCALE (NODE_ENV=development ou non defini)
LOCAL_DB_HOST="nom de l'hote de la base"
LOCAL_DB_PORT='le port de la base de donnee'
LOCAL_DB_USERNAME='utilisateur de la base'
LOCAL_DB_PASSWORD="mot de passe de la base"
LOCAL_DB_NAME="nom de la base"

# Base de donnees de TEST (NODE_ENV=test, connexion SSL)
TEST_DB_HOST=""
TEST_DB_PORT=""
TEST_DB_USERNAME=""
TEST_DB_PASSWORD=""
TEST_DB_NAME=""

# Base de donnees de PRODUCTION (NODE_ENV=production)
DB_HOST=""
DB_PORT=""
DB_USERNAME=""
DB_PASSWORD=""
DB_NAME=""

#cloudinary credentials (utilise quand NODE_ENV=test ou production)
CLOUDINARY_API_KEY='api key de cloudinary'
CLOUDINARY_API_SECRET='api secret de cloudinary'
CLOUDINARY_CLOUD_NAME='cloud name de cloudinary'
